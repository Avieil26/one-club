{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    },
    "apk": {
      "extends": "preview",
      "developmentClient": false,
      "channel": "android-hotfix-20261020",
      "environment": "production"
    },
    "apk-season2": {
      "extends": "apk",
      "channel": "android-season2-20261022",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
